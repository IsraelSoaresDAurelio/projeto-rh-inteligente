# Escolha o provedor: openai (API com custo) ou ollama (IA executada localmente).
IA_PROVIDER=ollama

# Ollama local: instale o Ollama e baixe o modelo antes de usar.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Mantém a memória usada pelo modelo dentro de um orçamento mais baixo.
OLLAMA_NUM_CTX=2048

# OpenAI: use apenas se IA_PROVIDER=openai. Nunca compartilhe esta chave.
OPENAI_API_KEY=cole_sua_chave_aqui
OPENAI_MODEL=gpt-5-mini
